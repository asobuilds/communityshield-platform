# Frontend environment (copy to .env.local)

# Base origin of the CommunityShield API (no trailing slash, no /api/v1 suffix —
# the client appends /api/v1 itself). Leave unset to use a same-origin /api/v1
# (e.g. behind a reverse proxy).
VITE_API_URL=https://communityshield-backend.onrender.com

# true  -> serve data from the in-browser mock API (no backend needed)
# false -> talk to the real API at VITE_API_URL
#
# `npm run dev` already defaults to true via .env.development; override it here
# (or in .env.local) to point the dev server at a real backend.
VITE_USE_MOCKS=true
