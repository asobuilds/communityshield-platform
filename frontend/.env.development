# Development defaults.
#
# The mock API is on by default because the Go backend cannot currently be built
# from this repository (go.sum is git-ignored), so there is no API to develop
# against. Every screen is therefore exercisable with `npm run dev` alone.
#
# To develop against a real backend instead, put this in .env.local (which takes
# precedence over this file):
#
#   VITE_USE_MOCKS=false
#   VITE_API_URL=http://localhost:8080
VITE_USE_MOCKS=true
